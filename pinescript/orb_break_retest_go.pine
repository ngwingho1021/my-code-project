//@version=6
// =============================================================================
// "One Box Scalper"  -  first-candle box, break -> retest -> reversal candle
// Reference: Scarface Trades, "My Simple 5 Minute 'First Candle' Scalping Strategy"
// -----------------------------------------------------------------------------
// 1. BOX   : high / low of the first 5-minute candle after the 09:30 NY open
//            (the 15-minute box is simulated as well, for comparison).
// 2. BREAK : on the 1-minute chart, wait for a candle to CLOSE outside the box.
//            No trades while price is inside the box.
// 3. RETEST: price comes back to the box edge and prints a reversal candle
//            LONG : hammer (long lower wick) or bullish engulfing
//            SHORT: shooting star / inverted hammer (long upper wick) or bearish engulfing
//            The confirmation candle must close back outside the box.
//            Enter on the next candle's open.
// 4. RISK  : SPX options mode (default): stop -15% / target +30% of the option premium,
//            converted to SPX points with delta (option move ~= delta x SPX move).
//            Chart mode: stop beyond the signal candle (or the retest swing), target = 2R.
//            Setup is cancelled if price pushes through to the opposite side of the box.
//            Only trade the first 90 minutes of the session.
//
// The Strategy Tester trades ONE box (5 or 15 min, chosen in the inputs). The
// on-chart table runs an identical simulation of BOTH boxes side by side so you
// can compare win rates in a single run.
//
// Use it on a 1-minute chart (that is how the strategy is executed).
// =============================================================================
strategy("One Box Scalper (5m vs 15m box)", shorttitle = "One Box", overlay = true,
     initial_capital = 100000, default_qty_type = strategy.percent_of_equity, default_qty_value = 10,
     commission_type = strategy.commission.percent, commission_value = 0, slippage = 0,
     pyramiding = 0)

// ----------------------------------------------------------------------------- inputs
grpOR   = "Box / session"
orPick  = input.string("5", "Box to TRADE (first N minutes)", options = ["5", "15"], group = grpOR,
     tooltip = "The Strategy Tester trades this box. The on-chart table always shows both.")
tz      = input.string("America/New_York", "Session timezone", group = grpOR)
sessH   = input.int(9,  "Session open  hour",   0, 23, inline = "o", group = grpOR)
sessM   = input.int(30, "minute",               0, 59, inline = "o", group = grpOR)
cutH    = input.int(11, "No new entries after hour", 0, 23, inline = "c", group = grpOR,
     tooltip = "Video: only trade the first 90 minutes (09:30 - 11:00).")
cutM    = input.int(0,  "minute",               0, 59, inline = "c", group = grpOR)
flatH   = input.int(15, "Close any open trade at hour", 0, 23, inline = "f", group = grpOR)
flatM   = input.int(55, "minute",               0, 59, inline = "f", group = grpOR)

grpRule      = "Break / retest rules"
dirMode      = input.string("Both", "Direction", options = ["Both", "Long only", "Short only"], group = grpRule)
breakBufPct  = input.float(0.0,  "Breakout close must be beyond box by (% of box)", minval = 0, step = 5, group = grpRule)
retestTolPct = input.float(10.0, "Retest zone: within (% of box) of the edge", minval = 0, step = 5, group = grpRule,
     tooltip = "A long retest = a candle whose LOW comes back to box high + this distance (or lower).")
failPct      = input.float(100.0, "Cancel setup if a candle closes back inside by (% of box)", minval = 0, step = 25, group = grpRule,
     tooltip = "100 = price closed through to the OPPOSITE side of the box (video rule).\n50 = closed past the middle of the box.")
useHammer    = input.bool(true, "Hammer / shooting star", inline = "p", group = grpRule)
useEngulf    = input.bool(true, "Engulfing",              inline = "p", group = grpRule)
wickMult     = input.float(2.0, "Hammer wick must be >= x times the body", minval = 0.5, step = 0.5, group = grpRule)
wickPctMin   = input.float(50.0, "Hammer wick must be >= % of candle range", minval = 0, maxval = 100, step = 5, group = grpRule)
maxTrades    = input.int(1, "Max trades per day", 1, 10, group = grpRule)

grpOpt   = "Exit rules (SPX options)"
exitMode = input.string("Option % (delta approx)", "Exit rules", options = ["Option % (delta approx)", "Chart stop (R)"], group = grpOpt,
     tooltip = "Option %: stop / target are a % of the option premium, converted to SPX points with the delta below.\nChart stop (R): use the chart-based stop and R target in the next section.")
optPrem  = input.float(20.0, "Option premium at entry ($)", minval = 0.05, step = 1, group = grpOpt,
     tooltip = "Typical price of the contract you buy (e.g. 0DTE ATM SPX call/put around 09:40).")
optDelta = input.float(0.50, "Option delta", minval = 0.05, maxval = 1, step = 0.05, group = grpOpt)
optSL    = input.float(15.0, "Stop loss (% of premium)",   minval = 1, step = 1, group = grpOpt)
optTP    = input.float(30.0, "Take profit (% of premium)", minval = 1, step = 1, group = grpOpt)

grpRisk    = "Stop / target (Chart stop mode)"
stopMode   = input.string("Signal candle", "Stop placement",
     options = ["Signal candle", "Retest swing", "Box midpoint", "Opposite side of box"], group = grpRisk,
     tooltip = "Signal candle: beyond the hammer / engulfing pattern.\nRetest swing: beyond the lowest low (long) / highest high (short) since the breakout.")
stopTicks  = input.int(1, "Stop buffer (ticks)", minval = 0, group = grpRisk)
rr         = input.float(2.0, "Target (reward : risk)", minval = 0.25, step = 0.25, group = grpRisk)

grpDate = "Backtest window"
useDate = input.bool(false, "Limit backtest to date range", group = grpDate)
startT  = input.time(timestamp("2024-01-01T00:00:00"), "Start", group = grpDate)
endT    = input.time(timestamp("2099-12-31T00:00:00"), "End",   group = grpDate)

grpVis    = "Display"
showTable = input.bool(true, "Show 5m vs 15m comparison table", group = grpVis)
show5     = input.bool(true, "Plot 5-minute box",  group = grpVis)
show15    = input.bool(true, "Plot 15-minute box", group = grpVis)

bool  optMode    = exitMode == "Option % (delta approx)"
// option P&L ~= delta x SPX move  ->  SPX points needed for the stop / target
float slPts      = optPrem * optSL / 100 / optDelta
float tpPts      = optPrem * optTP / 100 / optDelta

bool  allowLong  = dirMode != "Short only"
bool  allowShort = dirMode != "Long only"
float stopBuf    = stopTicks * syminfo.mintick

// ----------------------------------------------------------------------------- candle patterns (current bar)
float body      = math.abs(close - open)
float barRange  = high - low
float upperWick = high - math.max(open, close)
float lowerWick = math.min(open, close) - low

bool hammer       = barRange > 0 and lowerWick >= wickMult * body and lowerWick >= barRange * wickPctMin / 100 and upperWick < lowerWick
bool shootingStar = barRange > 0 and upperWick >= wickMult * body and upperWick >= barRange * wickPctMin / 100 and lowerWick < upperWick
bool bullEngulf   = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
bool bearEngulf   = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]

// ----------------------------------------------------------------------------- simulation object
// One instance per box length. Signals are generated on bar close and filled at
// the next bar's open, exactly like a strategy.entry() market order.
type Sim
    int   orMin
    float orHi
    float orLo
    bool  orReady  = false
    // 0 = waiting for a breakout close, 1 = broke out, waiting for retest + reversal candle
    int   lState   = 0
    int   sState   = 0
    int   lBreakBar
    int   sBreakBar
    float lSwing            // lowest low since the long breakout
    float sSwing            // highest high since the short breakout
    int   tradesToday = 0
    // open position
    int   pos      = 0
    float entry
    float stop
    float target
    float risk
    // order waiting for next bar's open
    int   pendDir  = 0
    float pendStop
    float pendTarget
    float pendRisk
    // signal produced on THIS bar (read by the strategy)
    int   sigDir   = 0
    float sigStop
    float sigTarget
    // stats (in R multiples of planned risk)
    int   wins     = 0
    int   losses   = 0
    float sumR     = 0.0
    float winR     = 0.0
    float lossR    = 0.0
    // per-direction stats
    int   lWins    = 0
    int   lLosses  = 0
    float lSumR    = 0.0
    int   sWins    = 0
    int   sLosses  = 0
    float sSumR    = 0.0

method closeTrade(Sim s, float px) =>
    float r = s.pos == 1 ? (px - s.entry) / s.risk : (s.entry - px) / s.risk
    s.sumR := s.sumR + r
    if r > 0
        s.wins := s.wins + 1
        s.winR := s.winR + r
    else
        s.losses := s.losses + 1
        s.lossR  := s.lossR - r
    if s.pos == 1
        s.lSumR := s.lSumR + r
        if r > 0
            s.lWins := s.lWins + 1
        else
            s.lLosses := s.lLosses + 1
    else
        s.sSumR := s.sSumR + r
        if r > 0
            s.sWins := s.sWins + 1
        else
            s.sLosses := s.sLosses + 1
    s.pos := 0

method queue(Sim s, int dir, float chartStop) =>
    float stopPx = optMode ? close - dir * slPts : chartStop
    float riskP  = dir == 1 ? close - stopPx : stopPx - close
    if riskP > 0
        s.sigDir      := dir
        s.sigStop     := stopPx
        s.sigTarget   := optMode ? close + dir * tpPts : close + dir * rr * riskP
        s.pendDir     := dir
        s.pendStop    := stopPx
        s.pendTarget  := s.sigTarget
        s.pendRisk    := riskP
        s.tradesToday := s.tradesToday + 1
    s.lState := 0
    s.sState := 0

method step(Sim s, bool newDay, int sessStart, int cutoffT, int flatT, bool inWindow) =>
    s.sigDir := 0
    int orEnd = sessStart + s.orMin * 60000

    if newDay
        if s.pos != 0           // safety net (e.g. missing bars) - should not happen
            s.closeTrade(open)
        s.orHi        := na
        s.orLo        := na
        s.orReady     := false
        s.lState      := 0
        s.sState      := 0
        s.tradesToday := 0
        s.pendDir     := 0

    // 1) fill the order queued on the previous bar at this bar's open
    if s.pendDir != 0
        s.pos     := s.pendDir
        s.entry   := open
        s.stop    := s.pendStop
        s.target  := s.pendTarget
        s.risk    := s.pendRisk
        if optMode                  // option stop / target are measured from the fill price
            s.stop   := open - s.pendDir * slPts
            s.target := open + s.pendDir * tpPts
            s.risk   := slPts
        s.pendDir := 0

    // 2) manage the open trade (same intrabar path TradingView's broker emulator assumes:
    //    if the open is closer to the high, the bar goes open -> high -> low -> close)
    if s.pos != 0
        bool  highFirst = (high - open) <= (open - low)
        float exitPx    = na
        if s.pos == 1
            if open <= s.stop or open >= s.target
                exitPx := open
            else
                bool hitS = low  <= s.stop
                bool hitT = high >= s.target
                exitPx := hitS and hitT ? (highFirst ? s.target : s.stop) : hitS ? s.stop : hitT ? s.target : na
        else
            if open >= s.stop or open <= s.target
                exitPx := open
            else
                bool hitS = high >= s.stop
                bool hitT = low  <= s.target
                exitPx := hitS and hitT ? (highFirst ? s.stop : s.target) : hitS ? s.stop : hitT ? s.target : na
        if not na(exitPx)
            s.closeTrade(exitPx)
        else if time_close >= flatT
            s.closeTrade(close)

    // 3) build the box
    if time >= sessStart and time < orEnd
        s.orHi := na(s.orHi) ? high : math.max(s.orHi, high)
        s.orLo := na(s.orLo) ? low  : math.min(s.orLo, low)
    else if time >= orEnd and not na(s.orHi)
        s.orReady := true

    // 4) break -> retest -> reversal candle
    if s.orReady and s.pos == 0 and s.pendDir == 0 and s.tradesToday < maxTrades and time_close <= cutoffT and inWindow
        float rng  = s.orHi - s.orLo
        float tol  = rng * retestTolPct / 100
        float fail = rng * failPct      / 100
        float brk  = rng * breakBufPct  / 100

        // ---- long side
        if allowLong
            if s.lState == 0
                if close > s.orHi + brk                           // candle closes above the box
                    s.lState    := 1
                    s.lBreakBar := bar_index
                    s.lSwing    := low
            else
                s.lSwing := math.min(s.lSwing, low)
                if close < s.orHi - fail                          // pushed through the box: cancel
                    s.lState := 0
                else if bar_index > s.lBreakBar and close > s.orHi
                    bool hamSig = useHammer and hammer and low <= s.orHi + tol
                    bool engSig = useEngulf and bullEngulf and bar_index - 1 > s.lBreakBar and math.min(low, low[1]) <= s.orHi + tol
                    if hamSig or engSig
                        float sigLow = engSig and not hamSig ? math.min(low, low[1]) : low
                        float stopPx = stopMode == "Signal candle" ? sigLow - stopBuf :
                                       stopMode == "Retest swing"  ? s.lSwing - stopBuf :
                                       stopMode == "Box midpoint"  ? (s.orHi + s.orLo) / 2 : s.orLo - stopBuf
                        s.queue(1, stopPx)

        // ---- short side
        if allowShort and s.pendDir == 0
            if s.sState == 0
                if close < s.orLo - brk                           // candle closes below the box
                    s.sState    := 1
                    s.sBreakBar := bar_index
                    s.sSwing    := high
            else
                s.sSwing := math.max(s.sSwing, high)
                if close > s.orLo + fail
                    s.sState := 0
                else if bar_index > s.sBreakBar and close < s.orLo
                    bool starSig = useHammer and shootingStar and high >= s.orLo - tol
                    bool engSig  = useEngulf and bearEngulf and bar_index - 1 > s.sBreakBar and math.max(high, high[1]) >= s.orLo - tol
                    if starSig or engSig
                        float sigHigh = engSig and not starSig ? math.max(high, high[1]) : high
                        float stopPx  = stopMode == "Signal candle" ? sigHigh + stopBuf :
                                         stopMode == "Retest swing"  ? s.sSwing + stopBuf :
                                         stopMode == "Box midpoint"  ? (s.orHi + s.orLo) / 2 : s.orHi + stopBuf
                        s.queue(-1, stopPx)

// ----------------------------------------------------------------------------- run
int  y   = year(time, tz)
int  mo  = month(time, tz)
int  d   = dayofmonth(time, tz)
int  sessStart = timestamp(tz, y, mo, d, sessH, sessM)
int  cutoffT   = timestamp(tz, y, mo, d, cutH,  cutM)
int  flatT     = timestamp(tz, y, mo, d, flatH, flatM)
bool newDay    = bar_index == 0 or d != dayofmonth(time[1], tz)
bool inWindow  = not useDate or (time >= startT and time <= endT)

var Sim sim5  = Sim.new(5)
var Sim sim15 = Sim.new(15)
sim5.step(newDay,  sessStart, cutoffT, flatT, inWindow)
sim15.step(newDay, sessStart, cutoffT, flatT, inWindow)

Sim active = orPick == "5" ? sim5 : sim15

if active.sigDir == 1
    strategy.entry("Long", strategy.long)
    if optMode
        strategy.exit("Long exit", "Long", loss = slPts / syminfo.mintick, profit = tpPts / syminfo.mintick)
    else
        strategy.exit("Long exit", "Long", stop = active.sigStop, limit = active.sigTarget)
else if active.sigDir == -1
    strategy.entry("Short", strategy.short)
    if optMode
        strategy.exit("Short exit", "Short", loss = slPts / syminfo.mintick, profit = tpPts / syminfo.mintick)
    else
        strategy.exit("Short exit", "Short", stop = active.sigStop, limit = active.sigTarget)

if strategy.position_size != 0 and time_close >= flatT
    strategy.close_all(comment = "EOD", immediately = true)

// ----------------------------------------------------------------------------- plots
plot(show5  and sim5.orReady  ? sim5.orHi  : na, "5m box high",  color.new(color.teal, 0),   2, plot.style_linebr)
plot(show5  and sim5.orReady  ? sim5.orLo  : na, "5m box low",   color.new(color.teal, 0),   2, plot.style_linebr)
plot(show15 and sim15.orReady ? sim15.orHi : na, "15m box high", color.new(color.orange, 0), 2, plot.style_linebr)
plot(show15 and sim15.orReady ? sim15.orLo : na, "15m box low",  color.new(color.orange, 0), 2, plot.style_linebr)
plot(active.pos != 0 ? active.stop   : na, "Stop",   color.new(color.red, 0),   1, plot.style_linebr)
plot(active.pos != 0 ? active.target : na, "Target", color.new(color.green, 0), 1, plot.style_linebr)
plotshape(active.sigDir == 1,  "Long signal",  shape.triangleup,   location.belowbar, color.green, size = size.small)
plotshape(active.sigDir == -1, "Short signal", shape.triangledown, location.abovebar, color.red,   size = size.small)

// ----------------------------------------------------------------------------- comparison table
fmt(float v, string f) => na(v) ? "-" : str.tostring(v, f)

winRate(Sim s) =>
    int n = s.wins + s.losses
    n > 0 ? 100.0 * s.wins / n : na

avgR(Sim s) =>
    int n = s.wins + s.losses
    n > 0 ? s.sumR / n : na

dirStats(int w, int l, float sumR) =>
    int n = w + l
    n > 0 ? str.tostring(n) + " | " + str.tostring(100.0 * w / n, "#.0") + "% | " + str.tostring(sumR, "#.0") + "R" : "-"

profitFactor(Sim s) =>
    s.lossR > 0 ? s.winR / s.lossR : na

var table tbl = table.new(position.top_right, 3, 16, bgcolor = color.new(color.black, 15),
     border_color = color.gray, border_width = 1, frame_color = color.gray, frame_width = 1)

row(int r, string label, string a, string b) =>
    table.cell(tbl, 0, r, label, text_color = color.white, text_halign = text.align_left, text_size = size.small)
    table.cell(tbl, 1, r, a,     text_color = color.white, text_size = size.small)
    table.cell(tbl, 2, r, b,     text_color = color.white, text_size = size.small)

if showTable and barstate.islast
    float wr5  = winRate(sim5)
    float wr15 = winRate(sim15)
    row(0, "Metric", "5-min box", "15-min box")
    row(1, "Trades",        str.tostring(sim5.wins + sim5.losses), str.tostring(sim15.wins + sim15.losses))
    row(2, "Wins / Losses", str.tostring(sim5.wins) + " / " + str.tostring(sim5.losses),
                             str.tostring(sim15.wins) + " / " + str.tostring(sim15.losses))
    row(3, "Win rate %",    fmt(wr5, "#.0"),              fmt(wr15, "#.0"))
    row(4, "Avg R / trade", fmt(avgR(sim5), "#.00"),      fmt(avgR(sim15), "#.00"))
    row(5, "Total R",       fmt(sim5.sumR, "#.0"),        fmt(sim15.sumR, "#.0"))
    row(6, "Profit factor", fmt(profitFactor(sim5), "#.00"), fmt(profitFactor(sim15), "#.00"))
    float beWr = optMode ? 100 * optSL / (optSL + optTP) : 100 / (1 + rr)
    row(7, "Break-even win rate %", fmt(beWr, "#.0"), fmt(beWr, "#.0"))
    if optMode
        row(8, "Avg option % / trade", fmt(avgR(sim5) * optSL, "#.0"), fmt(avgR(sim15) * optSL, "#.0"))
        row(9, "Total option %",       fmt(sim5.sumR * optSL, "#"),    fmt(sim15.sumR * optSL, "#"))
    else
        row(8, "Avg option % / trade", "-", "-")
        row(9, "Total option %",       "-", "-")
    string verdict = na(wr5) or na(wr15) ? "not enough trades" : wr5 > wr15 ? "5-min box" : wr15 > wr5 ? "15-min box" : "tie"
    row(10, "Higher win rate", verdict, "")
    row(11, "Strategy Tester trades", orPick + "-min box", "")
    row(12, "Exit rules", optMode ? "SL " + str.tostring(slPts, "#.#") + " / TP " + str.tostring(tpPts, "#.#") + " pts" : "Chart stop, " + str.tostring(rr) + "R", "")
    string tfNote = timeframe.in_seconds() > 60 ? "NOTE: video uses a 1-minute chart" : "Chart TF OK (1m)"
    row(13, "LONG  (trades | win% | R)", dirStats(sim5.lWins, sim5.lLosses, sim5.lSumR), dirStats(sim15.lWins, sim15.lLosses, sim15.lSumR))
    row(14, "SHORT (trades | win% | R)", dirStats(sim5.sWins, sim5.sLosses, sim5.sSumR), dirStats(sim15.sWins, sim15.sLosses, sim15.sSumR))
    row(15, tfNote, "", "")
    table.cell_set_bgcolor(tbl, 0, 13, color.new(color.green, 60))
    table.cell_set_bgcolor(tbl, 0, 14, color.new(color.red, 60))
    table.cell_set_bgcolor(tbl, 1, 10, color.new(color.green, 40))
